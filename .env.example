# Frontend URL used by the browser.
E2E_BASE_URL=http://localhost:3000

# Backend API base URL.
E2E_API_URL=http://localhost:8080/api/v1

# Credentials seeded into the disposable backend database.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=admin123

# Location for the disposable SQLite database and generated binary.
# Defaults to a directory under the system temp directory.
# E2E_TMP_DIR=/tmp/cardtalogue-e2e
